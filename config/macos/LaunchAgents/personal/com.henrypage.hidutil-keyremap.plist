<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.henrypage.hidutil-keyremap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/.dotfiles/scripts/macos/personal/macos-keyremap.sh"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Short on purpose: the built-in keyboard's HID service can be torn down and
         re-matched across sleep/wake (this machine sleeps/wakes dozens of times a day),
         which drops the UserKeyMapping until the next reapply. A short interval bounds
         that gap to a couple seconds instead of leaving it flaky for up to 30s. -->
    <key>StartInterval</key>
    <integer>3</integer>
</dict>
</plist>
