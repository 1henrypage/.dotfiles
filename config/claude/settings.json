{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude SubagentStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude PermissionRequest",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|elicitation_url_dialog|agent_needs_input|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude Notification",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!(Read|Grep|Glob|LS|TodoWrite|ToolSearch|BashOutput|Monitor|TaskCreate|TaskUpdate|TaskList|TaskGet|Skill)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!(Read|Grep|Glob|LS|TodoWrite|ToolSearch|BashOutput|Monitor|TaskCreate|TaskUpdate|TaskList|TaskGet|Skill)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/share/tmux/plugins/agentmux/hooks/agentmux-hook claude PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "showClearContextOnPlanAccept": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim"
}
